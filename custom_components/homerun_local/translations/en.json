        "data_description": {
          "host": "IP address or hostname of the machine running the HomeRun backend (server.py).",
          "port": "TCP port the backend listens on (default 8787).",
          "api_token": "Only when Home Assistant isn't on one of the backend's trusted networks: the token from the backend's api_token file. Not needed with the Home Assistant app."
